rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == playerId;
    }
    match /usernames/{usernameKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && usernameKey.matches('^[a-z][a-z0-9_]{2,15}$')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.usernameKey == usernameKey;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username'])
        && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.usernameKey == usernameKey;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}

